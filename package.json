{
  "name": "allfilesz",
  "productName": "allfilesZ",
  "version": "1.1.0",
  "description": "Glassy cross-platform file converter & compressor for Windows, Linux and macOS — images, audio, video, documents, archives. Fully offline.",
  "author": "allfilesZ contributors <allfilesz@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/dinaxy148822822-create/allfilesZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinaxy148822822-create/allfilesZ.git"
  },
  "keywords": [
    "converter",
    "compressor",
    "electron",
    "image",
    "audio",
    "video",
    "pdf",
    "archive",
    "cross-platform"
  ],
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "demo": "node scripts/demo-server.js",
    "icons": "node scripts/generate-icons.js",
    "test": "node tests/engines.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "async": "^3.2.6",
    "buffer-crc32": "^1.0.0",
    "compress-commons": "^6.0.2",
    "crc32-stream": "^6.0.0",
    "ffmpeg-static": "^5.2.0",
    "lazystream": "^1.0.1",
    "pdf-lib": "^1.17.1",
    "readable-stream": "^4.8.0",
    "readdir-glob": "^1.1.3",
    "sharp": "^0.33.5",
    "tar-stream": "^3.2.2",
    "zip-stream": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "engines": {
    "node": ">=18.17"
  }
}
